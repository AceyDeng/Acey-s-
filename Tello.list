DOMAIN-SUFFIX,api.keepcalling.net

# === DNS 解析稳定优化（建议保留）===
IP-CIDR,1.1.1.1/32,DIRECT,no-resolve     # Cloudflare DNS
IP-CIDR,8.8.8.8/32,DIRECT,no-resolve     # Google DNS
IP-CIDR6,2606:4700::/32,DIRECT,no-resolve # Cloudflare IPv6